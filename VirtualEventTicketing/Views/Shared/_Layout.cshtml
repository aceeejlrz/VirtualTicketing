@{
    var title = ViewData["Title"] as string ?? "Virtual Tickets";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title - Virtual Tickets</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
<header>
    <nav class="nav">
        <a class="brand" asp-controller="Home" asp-action="Index">🎟 Virtual Tickets</a>
        <a asp-controller="Events" asp-action="Index">Events</a>
        <a asp-controller="Events" asp-action="Overview">Overview</a>
        <a asp-controller="Purchases" asp-action="Create">Buy Tickets <span id="cartBadge" class="badge bg-success ms-1">0</span></a>
        <a asp-controller="Dashboard" asp-action="Index">Dashboard</a>

        @if (User.Identity?.IsAuthenticated ?? false)
        {
            <div class="nav-user">
                <span class="nav-user-pill">
                    <span class="nav-user-icon">👤</span>
                    <span class="nav-user-name">@User.Identity!.Name</span>
                </span>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline ms-2">
                    <button type="submit" class="btn btn-sm btn-outline-secondary">Logout</button>
                </form>
            </div>
        }
        else
        {
            <a asp-controller="Account" asp-action="Login">Login</a>
            <a asp-controller="Account" asp-action="Register">Register</a>
        }
    </nav>
</header>
<main class="container">
    @RenderBody()
</main>
<footer>
    <div>
        <strong>Group #100</strong> — Member(s): <em>Amran Hawaga, Jezrel Dela Cruz, Jared Duldulao</em> • COMP 2139 • Fall 2025
    </div>
</footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js"></script>
@RenderSection("Scripts", required: false)
</body>
</html>