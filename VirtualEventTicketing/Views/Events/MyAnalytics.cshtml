@{
    ViewData["Title"] = "My Analytics";
}

<h1 class="mb-4">Event Analytics</h1>

<div class="row mb-4">
    <div class="col-md-6">
        <h3>Ticket Sales by Category</h3>
        <canvas id="salesByCategoryChart"></canvas>
    </div>
    <div class="col-md-6">
        <h3>Monthly Revenue</h3>
        <canvas id="monthlyRevenueChart"></canvas>
    </div>
</div>

<h3>Top 5 Best-Selling Events</h3>
<table class="table table-striped" id="topEventsTable">
    <thead>
    <tr><th>Event</th><th>Tickets Sold</th><th>Revenue</th></tr>
    </thead>
    <tbody></tbody>
</table>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        (function() {
            const fetchJson = url => fetch(url).then(r => r.json());

            Promise.all([
                fetchJson('/Events/SalesByCategory'),
                fetchJson('/Events/MonthlyRevenue'),
                fetchJson('/Events/TopEvents')
            ]).then(([categories, monthly, top]) => {
                // Pie chart: sales by category
                const ctx1 = document.getElementById('salesByCategoryChart').getContext('2d');
                new Chart(ctx1, {
                    type: 'pie',
                    data: {
                        labels: categories.map(c => c.category ?? c.Category),
                        datasets: [{
                            data: categories.map(c => c.tickets ?? c.Tickets),
                            backgroundColor: ['#16a34a', '#f59e0b', '#3b82f6', '#ec4899', '#10b981']
                        }]
                    }
                });

                // Bar chart: monthly revenue
                const ctx2 = document.getElementById('monthlyRevenueChart').getContext('2d');
                new Chart(ctx2, {
                    type: 'bar',
                    data: {
                        labels: monthly.map(m => `${m.month}/${m.year}` ?? `${m.Month}/${m.Year}`),
                        datasets: [{
                            label: 'Revenue',
                            data: monthly.map(m => m.revenue ?? m.Revenue),
                            backgroundColor: '#3b82f6'
                        }]
                    },
                    options: {
                        scales: {
                            y: { beginAtZero: true }
                        }
                    }
                });

                // Table: top events
                const tbody = document.querySelector('#topEventsTable tbody');
                tbody.innerHTML = '';
                top.forEach(e => {
                    const tr = document.createElement('tr');
                    tr.innerHTML = `<td>${e.title ?? e.Title}</td><td>${e.tickets ?? e.Tickets}</td><td>${(e.revenue ?? e.Revenue).toFixed(2)}</td>`;
                    tbody.appendChild(tr);
                });
            });
        })();
    </script>
}
