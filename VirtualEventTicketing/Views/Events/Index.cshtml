@model IEnumerable<VirtualEventTicketing.Models.Event>
@using VirtualEventTicketing.ViewModels
@{
    ViewData["Title"] = "Events";
    var filter = (EventFilterVm)ViewBag.Filter;
}
<h2 class="vt-page-title">Explore Events</h2>
<div class="vt-card vt-filter-card">
<form method="get" class="filters">
    <input type="text" name="SearchTitle" value="@filter?.SearchTitle" placeholder="Search title" />
    <label>From <input type="datetime-local" name="From" value="@filter?.From?.UtcDateTime.ToString("yyyy-MM-ddTHH:mm")" /></label>
    <label>To <input type="datetime-local" name="To" value="@filter?.To?.UtcDateTime.ToString("yyyy-MM-ddTHH:mm")" /></label>
    <select name="CategoryId">
        <option value="">All categories</option>
        @foreach (var c in filter.Categories)
        {
            <option value="@c.Value" selected="@(filter.CategoryId?.ToString()==c.Value)">@c.Text</option>
        }
    </select>
    <select name="Availability">
        <option value="">Any availability</option>
        <option value="available" selected="@(filter?.Availability=="available")">Available</option>
        <option value="soldout" selected="@(filter?.Availability=="soldout")">Sold out</option>
    </select>
    <select name="SortBy">
        <option value="date" selected="@(filter?.SortBy=="date")">Sort by date</option>
        <option value="title" selected="@(filter?.SortBy=="title")">Sort by title</option>
        <option value="price" selected="@(filter?.SortBy=="price")">Sort by price</option>
    </select>
    <label><input type="checkbox" name="SortDesc" value="true" @(filter?.SortDesc==true?"checked":"") /> Desc</label>
    <button class="btn vt-btn" type="submit">Apply</button>
    @if (User.IsInRole("Admin") || User.IsInRole("Organizer"))
    {
        <a class="btn outline vt-btn" asp-action="Create">Add Event</a>
    }
</form>
</div>

<div class="vt-card vt-table-card">
<table class="grid vt-card-table vt-card-grid-table">
    <thead>
        <tr>
            <th>Title</th>
            <th>Category</th>
            <th>Date/Time</th>
            <th>Price</th>
            <th>Available</th>
            <th></th>
        </tr>
    </thead>
        <tbody>
        @foreach (var e in Model)
        {
            <tr class="vt-event-row @(e.AvailableTickets < 5 ? "low" : "")">
                <td class="vt-event-title"><a asp-action="Details" asp-route-id="@e.EventId">@e.Title</a></td>
                <td>@e.Category?.Name</td>
                <td>@e.StartDateTime.LocalDateTime</td>
                <td>$@e.TicketPrice</td>
                <td>
                    <span class="vt-badge">@e.AvailableTickets left</span>
                </td>
                <td class="actions vt-card-footer">
                    @if (User.IsInRole("Admin") || User.IsInRole("Organizer"))
                    {
                        <a asp-action="Edit" asp-route-id="@e.EventId">Edit</a>
                        <a asp-action="Delete" asp-route-id="@e.EventId">Delete</a>
                    }
                    @if(!e.IsSoldOut){
                        <button type="button" class="btn btn-sm js-add-to-cart" data-event-id="@e.EventId">Add to cart</button>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
