@model VirtualEventTicketing.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<h1 class="mb-4">My Dashboard</h1>

<ul class="nav nav-tabs" id="dashboardTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="tickets-tab" data-bs-toggle="tab" data-bs-target="#tickets" type="button" role="tab">My Tickets</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="history-tab" data-bs-toggle="tab" data-bs-target="#history" type="button" role="tab">Purchase History</button>
    </li>
    @if (User.IsInRole("Organizer") || User.IsInRole("Admin"))
    {
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="myevents-tab" data-bs-toggle="tab" data-bs-target="#myevents" type="button" role="tab">My Events</button>
        </li>
    }
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="profile-tab" data-bs-toggle="tab" data-bs-target="#profile" type="button" role="tab">Profile</button>
    </li>
</ul>

<div class="tab-content mt-3">
    <div class="tab-pane fade show active" id="tickets" role="tabpanel">
        <h3>Upcoming Tickets</h3>
        @if (!Model.UpcomingTickets.Any())
        {
            <p class="text-muted">No upcoming tickets.</p>
        }
        else
        {
            <table class="table table-striped">
                <thead><tr><th>Event</th><th>Date</th><th>Qty</th><th>QR</th><th>PDF</th></tr></thead>
                <tbody>
                @foreach (var item in Model.UpcomingTickets)
                {
                    <tr>
                        <td>@item.Event!.Title</td>
                        <td>@item.Event.StartDateTime.LocalDateTime</td>
                        <td>@item.Quantity</td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.QrCodePath))
                            {
                                <img src="@item.QrCodePath" alt="QR" style="width:80px;height:80px;" />
                            }
                        </td>
                        <td>
                            <a class="btn btn-sm btn-outline-primary" asp-controller="Purchases" asp-action="TicketPdf" asp-route-purchaseId="@item.PurchaseId" asp-route-itemId="@item.PurchaseItemId">PDF</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>

    <div class="tab-pane fade" id="history" role="tabpanel">
        <h3>Purchase History</h3>
        @if (!Model.PastTickets.Any())
        {
            <p class="text-muted">No past tickets.</p>
        }
        else
        {
            <table class="table table-striped">
                <thead><tr><th>Event</th><th>Date</th><th>Qty</th><th>Rating</th></tr></thead>
                <tbody>
                @foreach (var item in Model.PastTickets)
                {
                    <tr>
                        <td>@item.Event!.Title</td>
                        <td>@item.Event.StartDateTime.LocalDateTime</td>
                        <td>@item.Quantity</td>
                        <td>
                            <form asp-action="RateTicket" method="post" class="d-inline">
                                <input type="hidden" name="purchaseItemId" value="@item.PurchaseItemId" />
                                <select name="rating" class="form-select form-select-sm d-inline w-auto">
                                    @for (var r = 1; r <= 5; r++)
                                    {
                                        <option value="@r" selected="@(item.Rating == r)">@r</option>
                                    }
                                </select>
                                <button type="submit" class="btn btn-sm btn-outline-secondary">Save</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>

    @if (User.IsInRole("Organizer") || User.IsInRole("Admin"))
    {
        <div class="tab-pane fade" id="myevents" role="tabpanel">
            <h3>My Events (Organizer)</h3>
            @if (!Model.MyEvents.Any())
            {
                <p class="text-muted">No sales yet.</p>
            }
            else
            {
                <table class="table table-striped">
                    <thead><tr><th>Event</th><th>Tickets Sold</th><th>Revenue</th></tr></thead>
                    <tbody>
                    @foreach (var e in Model.MyEvents)
                    {
                        <tr>
                            <td>@e.Title</td>
                            <td>@e.TicketsSold</td>
                            <td>@e.Revenue.ToString("C")</td>
                        </tr>
                    }
                    </tbody>
                </table>
                <a class="btn btn-outline-primary" asp-controller="Events" asp-action="MyAnalytics">View Analytics</a>
            }
        </div>
    }

    <div class="tab-pane fade" id="profile" role="tabpanel">
        <h3>Profile</h3>
        <form asp-action="UpdateProfile" method="post" enctype="multipart/form-data" class="card p-4 shadow-sm mt-2">
            <div class="mb-3">
                <label class="form-label">Full name</label>
                <input asp-for="Profile.FullName" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Phone number</label>
                <input asp-for="Profile.PhoneNumber" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Profile picture</label>
                <input asp-for="Profile.ProfileImageFile" type="file" class="form-control" />
                @if (!string.IsNullOrEmpty(Model.Profile.ProfileImagePath))
                {
                    <img src="@Model.Profile.ProfileImagePath" alt="Profile" class="mt-2" style="width:80px;height:80px;border-radius:50%;" />
                }
            </div>
            <button type="submit" class="btn btn-primary">Save profile</button>
        </form>
    </div>
</div>
